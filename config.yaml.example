# !Clipit Configuration
# Copy this file to config.yaml and fill in your values.
# These values are used as defaults for a broadcaster the first time they connect.

app:
  base_url: "https://your-domain.example.com"
  host: "0.0.0.0"
  port: 8000
  session_secret: "change-me-in-production"

# Twitch API Credentials
# Use environment variables for secrets in production.
twitch:
  client_id: "" # Prefer TWITCH_CLIENT_ID
  client_secret: "" # Prefer TWITCH_CLIENT_SECRET
  redirect_path: "/auth/twitch/callback"

# Initial broadcaster defaults.
# After a broadcaster logs in, these settings are copied into the database
# and can be changed per broadcaster via the authenticated API.
commands:
  - "!clipit"
  - "!clip"

donotallowlist:
  enabled: true
  usernames: ["baduser", "botabusinguser"]

voting:
  minimum_votes: 2
  command_window: 15
  command_cooldown: 30

permissions:
  vote_permissions: "Everyone"
  subscriber_months: "SUB:3"
  override_permissions: "Owner"

discord:
  webhook_url: ""
